{
  "name": "condex",
  "private": true,
  "workspaces": [
    "packages/condex-core",
    "packages/condex-java",
    "packages/condex-multi-lang",
    "packages/condex-cli"
  ],
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "preinstall": "node scripts/check-prerequisites.js",
    "check": "node scripts/check-prerequisites.js",
    "setup": "npm run check && bash condex-setup.sh",
    "build": "npm run check && npm run build --workspaces",
    "test": "npm run check && npm run test --workspaces --if-present",
    "dev": "npm run check && npm run dev --workspace=packages/condex-core"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
